# Copy to .env.local and fill in. Never commit .env.local.

# IBM Cloud API key (used server-side only to get an IAM bearer token)
WATSONX_API_KEY=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=f7657b6e-aa8c-4445-86d0-91809ca0edd8
# Tool-calling models verified on this project: meta-llama/llama-3-3-70b-instruct,
# mistralai/mistral-medium-2505, openai/gpt-oss-120b
WATSONX_MODEL=meta-llama/llama-3-3-70b-instruct

# Web search provider (watsonx has no built-in web search). Get a key at https://tavily.com
TAVILY_API_KEY=

# Optional: require this code in the UI before research runs (protects your credits).
# Leave empty to disable.
ACCESS_CODE=

# Optional tuning
MAX_SEARCHES=12
RATE_LIMIT_PER_HOUR=10
